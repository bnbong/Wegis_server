# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Wegis Server"
SECRET_KEY=your-secret-key-here

# CORS Settings
CLIENT_ORIGIN=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:9000

# PostgreSQL Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=phishing_data

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_NAMESPACE=wegis
REDIS_MAX_CONNECTIONS=10
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SOCKET_TIMEOUT=5

# AI Model Settings
MODEL_NAME=best_acc_model.pt
HTML_LOAD_TIMEOUT=20
HTML_LOAD_RETRIES=2
# Max bytes read from an HTTP response body when fetching HTML (non-HTML bodies are not downloaded)
HTTP_FETCH_MAX_BYTES=3000000

# Chrome/Selenium Settings
CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Domain Management
DOMAIN_ENABLE_PATTERNS=true

# URL Reputation (threat intelligence) — each provider is disabled when its key is empty
REPUTATION_ENABLED=true
REPUTATION_TIMEOUT=4.0
REPUTATION_MAX_CONCURRENCY=8
REPUTATION_CACHE_TTL_MALICIOUS=21600
REPUTATION_CACHE_TTL_CLEAN=1800
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# VirusTotal download scanning (only queried for high-risk download URLs)
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_MALICIOUS_THRESHOLD=2
VIRUSTOTAL_SUBMIT_UNKNOWN=false

# Block-signal policy (model confidence = P(phishing) thresholds)
MODEL_BLOCK_THRESHOLD=0.95
MODEL_WARN_THRESHOLD=0.75

# Analysis trigger policy (links = reputation-only + cache-first by default)
LINK_BACKGROUND_MODEL=false
LINK_BG_CONCURRENCY=4
LINK_BG_MAX_INFLIGHT=256

# Operational safety — batch & concurrency guards
MAX_BATCH_URLS=50
BATCH_CONCURRENCY=8
BATCH_PER_URL_TIMEOUT=6.0
MAX_CONCURRENT_REQUESTS=32

# SSRF guard for outbound fetches
SSRF_GUARD_ENABLED=true
FETCH_MAX_REDIRECTS=3

# Rate limiting (Redis-backed, fail-open) + optional static-token auth
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHECK_PER_MIN=120
RATE_LIMIT_BATCH_PER_MIN=12
# Comma-separated allowlist; empty = no auth
WEGIS_API_TOKENS=
